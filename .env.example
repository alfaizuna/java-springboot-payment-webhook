# ==============================================================================
# Baseapp Environment Variables Template
# Copy file ini menjadi .env untuk deployment lokal / staging / production
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baseapp_db
DB_USERNAME=postgres
DB_PASSWORD=secret_password_here
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Redis Configuration (Token Blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Application Server
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# JWT Security (RS256 Asymmetric RSA)
# Jalur lokasi file RSA Key (mendukung 'classpath:certs/...' atau 'file:/path/to/...')
RSA_PRIVATE_KEY_LOCATION=classpath:certs/private_key.pem
RSA_PUBLIC_KEY_LOCATION=classpath:certs/public_key.pem

# Token Durations (dalam milidetik)
# 86400000 ms = 24 jam (1 hari)
JWT_EXPIRATION=86400000
# 604800000 ms = 7 hari
REFRESH_TOKEN_EXPIRATION=604800000
